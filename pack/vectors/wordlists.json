				{ "schema": "voiceflow-op", "version": 1, "id": "dev2-b", "device": "dev2", "createdAt": "2026-11-17T09:00:00Z",
					"type": "correction", "from": ["Glim"], "to": "Glimm", "scope": { "apps": ["*"] } }
			],
			"expect": { "terms": {}, "corrections": ["Glim -> Glimm"], "issues": ["correction-conflict"], "rejected": [] }
		},
