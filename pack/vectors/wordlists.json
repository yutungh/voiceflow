				"keywords": ["Quibbit", "Kestrel"]
			}
		},
		{
			"name": "a hint is at most 120 characters: heard-as forms that don't fit are left out whole",
			"promptChars": 600, "promptTerms": 40, "app": null,
			"terms": [
				{"id": "a", "text": "Flumox", "gloss": "our project, pronounced flu-mocks, never the medicine", "heardAs": ["Flu Mocks", "Flew Mox", "Flume Ox", "Floo Mocks", "Flu Mox Ltd"], "priority": 90, "apps": ["*"], "layer": "edit"}
			],
			"expect": {
				"prompt": "Vocabulary: Flumox (our project, pronounced flu-mocks, never the medicine; not \"Flu Mocks\" or \"Flew Mox\" or \"Flume Ox\" or \"Floo Mocks\")",
				"sent": ["Flumox"],
				"keywords": ["Flumox"]
			}
		},
		{
			"name": "control characters become spaces, brackets and double quotes leave hints, a word differing only in case is sent once",
			"promptChars": 600, "promptTerms": 40, "app": null,
			"terms": [
				{"id": "a", "text": "Pip\tSqueak", "heardAs": ["pip (squeak)"], "gloss": "the \"small\" one", "priority": 90, "apps": ["*"], "layer": "personal"},
				{"id": "b", "text": "pip squeak", "priority": 10, "apps": ["*"], "layer": "household"}
			],
			"expect": {
				"prompt": "Vocabulary: Pip Squeak (the 'small' one)",
				"sent": ["Pip Squeak"],
				"keywords": ["Pip Squeak"]
			}
		}
