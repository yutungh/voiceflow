			"terms": [
				{"id": "a", "text": "Milo", "priority": 90, "apps": ["*"], "layer": "personal"},
				{"id": "b", "text": "Kestrel", "priority": 10, "apps": ["teamchat.exe"], "layer": "personal"},
				{"id": "c", "text": "Glim", "priority": 99, "apps": ["notes.exe"], "layer": "personal"}
			],
			"expect": {
				"prompt": "Vocabulary: Milo, Kestrel",
				"sent": ["Milo", "Kestrel"],
				"keywords": ["Milo", "Kestrel"]
			}
		},
		{
			"name": "hints: the own gloss, a generated gloss only when it says how the word sounds, heard-as forms",
			"promptChars": 600, "promptTerms": 40, "app": null,
			"terms": [
				{"id": "a", "text": "ZDRL", "heardAs": ["Z-drill", "zee drill"], "gloss": "said \"zee-drul\"", "priority": 90, "apps": ["*"], "layer": "generated"},
