			"user": "sam",
			"personal": { "schema": "voiceflow-profile", "schemaVersion": 1, "layer": "personal", "user": "sam",
				"terms": [{ "id": "quibbit", "text": "Quibbit", "priority": 90 }, { "id": "quibbit-2", "text": "quibbit" }] },
			"expect": { "terms": { "quibbit-2": "quibbit" }, "corrections": [], "issues": ["duplicate-word"], "rejected": [] }
		},
		{
			"name": "words compare in lower case beyond ASCII",
			"user": "sam",
			"household": { "schema": "voiceflow-profile", "schemaVersion": 1, "layer": "household", "user": "household",
				"terms": [{ "id": "ozel", "text": "ÖZEL Ärger" }] },
			"personal": { "schema": "voiceflow-profile", "schemaVersion": 1, "layer": "personal", "user": "sam",
				"terms": [{ "id": "ozel-2", "text": "özel  ärger" }] },
			"expect": { "terms": { "ozel-2": "özel  ärger" }, "corrections": [], "issues": [], "rejected": [] }
		},
		{
			"name": "a tombstone for an edit never seen changes nothing",
			"user": "sam",
			"ops": [
				{ "schema": "voiceflow-op", "version": 1, "id": "dev1-a", "device": "dev1", "createdAt": "2026-11-17T10:00:00Z",
					"type": "term", "term": { "text": "Quibbit" } },
				{ "schema": "voiceflow-op", "version": 1, "id": "dev1-b", "device": "dev1", "createdAt": "2026-11-17T10:01:00Z",
					"type": "tombstone", "target": "dev9-zzz" }
