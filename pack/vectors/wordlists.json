				{ "schema": "voiceflow-op", "version": 1, "id": "dev3-c", "device": "dev3", "createdAt": "2026-11-16T09:00:00Z",
					"type": "correction", "from": ["Kwibbit"], "to": "Kwibit", "scope": { "apps": ["*"] } },
				{ "schema": "voiceflow-op", "version": 1, "id": "dev1-a", "device": "dev1", "createdAt": "2026-11-17T09:00:00Z",
					"type": "correction", "from": ["Kwibbit"], "to": "Quibit", "scope": { "apps": ["*"] } }
			],
			"expect": { "terms": {}, "corrections": ["Kwibbit -> Quibbit"], "issues": ["correction-conflict", "correction-conflict"], "rejected": [] }
		},
		{
