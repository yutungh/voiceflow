			"promptChars": 600, "promptTerms": 2, "app": null,
			"terms": [
				{"id": "a", "text": "Milo", "priority": 30, "apps": ["*"], "layer": "personal"},
				{"id": "b", "text": "Febe", "priority": 20, "apps": ["*"], "layer": "personal"},
				{"id": "c", "text": "Pinewood", "priority": 10, "apps": ["*"], "layer": "personal"}
