	"prompt": [
		{
			"name": "words by priority within the budget, most relevant last",
			"promptChars": 600, "promptTerms": 40, "app": null,
			"terms": [
				{"id": "a", "text": "Milo", "priority": 50, "apps": ["*"], "layer": "household"},
				{"id": "b", "text": "Pinewood", "priority": 80, "apps": ["*"], "layer": "generated"},
				{"id": "c", "text": "Febe", "priority": 80, "apps": ["*"], "layer": "personal"},
				{"id": "d", "text": "QBR", "priority": 10, "apps": ["*"], "layer": "personal"}
			],
			"expect": {
				"prompt": "Vocabulary: QBR, Milo, Pinewood, Febe",
				"sent": ["QBR", "Milo", "Pinewood", "Febe"],
				"keywords": ["QBR", "Milo", "Pinewood", "Febe"]
			}
		},
		{
			"name": "a word that doesn't fit is skipped and the next one tried",
			"promptChars": 40, "promptTerms": 40, "app": null,
			"terms": [
